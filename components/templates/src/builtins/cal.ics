{% if feed_url is containing("events") %}
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//hacksw/handcal//NONSGML v1.0//EN
{%- for page in pages %}
BEGIN:VEVENT
UID:{{ page.permalink | safe }}
DTSTAMP:19970701T100000Z{% if page.extra.start_date %}
DTSTART:{{ page.extra.start_date | date(format="%Y%m%dT%H%M%S") }}{% endif %}{% if page.extra.end_date %}
DTEND:{{ page.extra.end_date | date(format="%Y%m%dT%H%M%S") }}{% endif %}
SUMMARY:{{ page.title }}{% if page.summary %}
DESCRIPTION:{{ page.summary }}
{% else %}
DESCRIPTION:{{ page.content | linebreaksbr | replace(from="<br>", to="\n") | striptags }}
{% endif %}{% if page.extra.geo %}
GEO:{{ page.extra.geo }}{% endif %}
END:VEVENT
{%- endfor %}
END:VCALENDAR{% endif %}